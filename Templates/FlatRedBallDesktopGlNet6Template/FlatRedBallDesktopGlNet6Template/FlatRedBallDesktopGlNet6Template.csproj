<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>MONOGAME;DESKTOP_GL;MONOGAME_381</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <RootNamespace>FlatRedBallDesktopGlNet6Template</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
    <None Remove="**\*.glsj" />
	  <None Remove="**\*.glej" />
	  <None Remove="**\*.gluj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Game1.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico" />
    <EmbeddedResource Include="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <!-- The whole engine comes from NuGet, so it moves as one matched set on restore. These five
         used to be split: the engine from NuGet and the rest as loose DLLs in a Libraries folder,
         which let a project pair a current engine with a months-old GumCore. -->
    <PackageReference Include="FlatRedBallDesktopGLNet6" Version="2026.8.3.1114" />
    <PackageReference Include="FlatRedBall.Forms.DesktopGlNet6" Version="2026.8.3.1114" />
    <PackageReference Include="FlatRedBall.GumCore.DesktopGlNet6" Version="2026.8.3.1114" />
    <PackageReference Include="FlatRedBall.SkiaInGum" Version="2026.8.3.1114" />
    <PackageReference Include="FlatRedBall.StateInterpolation.DesktopNet6" Version="2026.8.3.1114" />

    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
    <!-- Must stay at or above what FlatRedBall.SkiaInGum was built against, or restore reports a
         downgrade. The HintPath this replaced carried no version information, so the template
         previously pinned SkiaSharp 2.88.6 against a SkiaInGum compiled for 3.x. -->
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Content\Shader.fx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\shader.xnb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\ShaderForcePoint.fx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\ShaderForcePoint.xnb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
    <Message Text="Restoring dotnet tools" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
</Project>