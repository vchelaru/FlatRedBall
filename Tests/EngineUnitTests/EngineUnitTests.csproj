<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Gum\GumCore\GumCoreXnaPc\GumCore.DesktopGlNet6\GumCore.DesktopGlNet6.csproj" />
    <ProjectReference Include="..\..\Engines\FlatRedBallXNA\FlatRedBallDesktopGLNet6\FlatRedBallDesktopGLNet6.csproj" />
    <ProjectReference Include="..\..\Engines\Forms\FlatRedBall.Forms\FlatRedBall.Forms.DesktopGlNet6\FlatRedBall.Forms.DesktopGlNet6.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled directly from Glue's embedded-code source (verbatim-copied into every generated
         game project as GlueControl/Editing/*.Generated.cs) so tests exercise the real code. -->
    <Compile Include="..\..\FRBDK\Glue\GameCommunicationPlugin\GlueControl\Embedded\Editing\EditorVisuals.cs">
      <Link>GlueControl\Editing\EditorVisuals.cs</Link>
    </Compile>
    <Compile Include="..\..\FRBDK\Glue\GameCommunicationPlugin\GlueControl\Embedded\Editing\Visuals\Arrow.cs">
      <Link>GlueControl\Editing\Visuals\Arrow.cs</Link>
    </Compile>
    <Compile Include="..\..\FRBDK\Glue\GameCommunicationPlugin\GlueControl\Embedded\Editing\GumCursorLogic.cs">
      <Link>GlueControl\Editing\GumCursorLogic.cs</Link>
    </Compile>
  </ItemGroup>

  <!-- The tile map code the Tiled plugin embeds into game projects (same list as TiledPlugin.csproj).
       Glue replaces each file's $GLUE_VERSIONS$ line with #defines; here the line is blanked and the
       defines come from DefineConstants, since this project builds against current engine source. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);REFERENCES_FRB_SOURCE;ShapeCollectionHasMaxAxisAlignedRectanglesRadiusX;SupportsNamedSubcollisions;ShapeManagerCollideAgainstClosest;ShapeCollectionHasIsPointOnOrInside;IStackableInEngine;IPositionedSizedObjectInEngine;TILEMAPS_ALPHA_AND_COLOR</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedTileMapSource Include="..\..\Engines\FlatRedBallAddOns\FlatRedBall.TileCollisions\TileShapeCollection.cs" />
    <EmbeddedTileMapSource Include="..\..\Engines\FlatRedBallAddOns\FlatRedBall.TileGraphics\FlatRedBall.TileGraphics\*.cs" />
    <EmbeddedTileMapSource Include="..\..\Tiled\TMXGlueLib\AbstractMapLayer.cs" />
    <EmbeddedTileMapSource Include="..\..\Tiled\TMXGlueLib\DataTypes\NamedValue.cs" />
    <EmbeddedTileMapSource Include="..\..\Tiled\TMXGlueLib\DataTypes\ReducedTileMapInfo.cs" />
    <EmbeddedTileMapSource Include="..\..\Tiled\TMXGlueLib\DataTypes\ReducedTileMapInfo.TiledMapSave.cs" />
    <EmbeddedTileMapSource Include="..\..\Tiled\TMXGlueLib\ExternalTileset.cs" />
    <EmbeddedTileMapSource Include="..\..\Tiled\TMXGlueLib\MapLayer.cs" />
    <EmbeddedTileMapSource Include="..\..\Tiled\TMXGlueLib\MapTileset.cs" />
    <EmbeddedTileMapSource Include="..\..\Tiled\TMXGlueLib\MapTilesetTile.cs" />
    <EmbeddedTileMapSource Include="..\..\Tiled\TMXGlueLib\TiledManualDeserializer.cs" />
    <EmbeddedTileMapSource Include="..\..\Tiled\TMXGlueLib\TileAnimation.cs" />
    <EmbeddedTileMapSource Include="..\..\Tiled\TMXGlueLib\TileAnimationFrame.cs" />
    <EmbeddedTileMapSource Include="..\..\Tiled\TMXGlueLib\TiledMapSave.Conversion.cs" />
    <EmbeddedTileMapSource Include="..\..\Tiled\TMXGlueLib\TiledMapSave.Serialization.cs" />
    <EmbeddedTileMapSource Include="..\..\Tiled\TMXGlueLib\TiledMapToShapeCollectionConverter.cs" />
    <EmbeddedTileMapSource Include="..\..\Tiled\TMXGlueLib\TilesetExtensionMethods.cs" />
  </ItemGroup>
  <Target Name="StampEmbeddedTileMapSources" BeforeTargets="BeforeBuild">
    <WriteLinesToFile File="$(IntermediateOutputPath)TileGraphics\%(EmbeddedTileMapSource.Filename)%(EmbeddedTileMapSource.Extension)"
                      Lines="$([MSBuild]::Escape($([System.IO.File]::ReadAllText('%(EmbeddedTileMapSource.FullPath)').Replace('$GLUE_VERSIONS$', ''))))"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)TileGraphics\*.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
