<UserControl
    x:Class="GameCommunicationPlugin.GlueControl.Views.EditingToolsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localization="clr-namespace:Localization;assembly=Localization"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="28"
    mc:Ignorable="d">
    <StackPanel>
        <ToggleButton
            x:Name="SelectToggleButton"
            Height="20"
            Click="SelectObjectsToggleClicked"
            Content="{materialDesign:PackIcon CursorDefaultOutline}"
            Style="{DynamicResource IconToggleButton}" />
        <StackPanel x:Name="TileButtonsStack" />
        <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding ToolbarEntitiesAndStates}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button
                        Width="24"
                        Height="24"
                        Command="{Binding ClickedCommand}">
                        <Image IsHitTestVisible="False" Source="{Binding ImageSource}" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ViewInExplorerCommand}" Header="Starts the game in edit mode on the startup screen." />
                                <MenuItem Header="{x:Static localization:Texts.SetPreviewFile}">
                                    <MenuItem Command="{Binding SelectPreviewFileCommand}" Header="{x:Static localization:Texts.FromCustomFile}" />
                                    <MenuItem Command="{Binding SelectPreviewFromEntityCommand}" Header="{x:Static localization:Texts.FromEntity}" />
                                </MenuItem>
                                <MenuItem Command="{Binding ForceRefreshPreviewCommand}" Header="{Binding RefreshPreviewText}" />
                                <Separator />
                                <MenuItem Command="{Binding RemoveFromToolbarCommand}" Header="{x:Static localization:Texts.RemoveFromToolbar}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Text="{Binding TooltipText}"
                                        TextAlignment="Center" />
                                    <Image
                                        Height="64"
                                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                                        Source="{Binding ImageSource}" />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
