<UserControl
    x:Class="OfficialPlugins.GameHost.Views.GameHostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FlatRedBall.Glue.Controls;assembly=GlueFormsCore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localization="clr-namespace:Localization;assembly=Localization"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:GameCommunicationPlugin.GlueControl.Views"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--<RowDefinition Height="{Binding DragDropHeight}"></RowDefinition>-->
            <!--<RowDefinition Height="{Binding GameWindowHeight}"></RowDefinition>-->
            <!--<RowDefinition Height="{Binding DragDropHeight}"></RowDefinition>-->
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel
                Grid.Column="0"
                Margin="2"
                Orientation="Horizontal">

                <Button
                    Height="20"
                    Margin="0,2,6,0"
                    HorizontalAlignment="Left"
                    Click="PlayInEditModeClicked"
                    Content="{materialDesign:PackIcon Kind=PlayBoxEditOutline}"
                    Style="{DynamicResource IconButton}"
                    Visibility="{Binding RunInEditModeButtonVisibility}">
                    <Button.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Text="Run In Edit Mode" />
                                <TextBlock Text="Starts the game in edit mode on the startup screen." />
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>

                <views:WhileRunningView
                    Height="28"
                    Margin="0,2,6,0"
                    AdvanceOneFrameClicked="WhileRunningView_AdvanceOneFrameClicked"
                    PauseClicked="WhileRunningView_PauseClicked"
                    RestartGameClicked="WhileRunningView_RestartGameClicked"
                    RestartGameCurrentScreenClicked="WhileRunningView_RestartGameCurrentScreenClicked"
                    RestartScreenClicked="WhileRunningView_RestartScreenClicked"
                    StopClicked="WhileRunningView_StopClicked"
                    UnpauseClicked="WhileRunningView_UnpauseClicked"
                    Visibility="{Binding WhileRunningViewVisibility}" />

                <Grid Margin="5,0,0,0" Visibility="Collapsed">
                    <Frame Background="{Binding ConnectedFrameBackgroundColor, FallbackValue=Red}" />
                    <TextBlock
                        Margin="4"
                        VerticalAlignment="Center"
                        Text="{Binding ConnectedString, FallbackValue=Connected}" />
                </Grid>

            </WrapPanel>

            <StackPanel
                x:Name="AlwaysVisibleStack"
                Grid.Column="1"
                Margin="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <Image
                    Height="24"
                    Source="/GameCommunicationPlugin;component/GlueControl/Icons/Connected.png"
                    Visibility="{Binding ConnectedButtonVisibility}">
                    <Image.ToolTip>
                        <TextBlock>Connected to game</TextBlock>
                    </Image.ToolTip>
                </Image>
                <Image
                    Height="24"
                    Source="/GameCommunicationPlugin;component/GlueControl/Icons/Disconnected.png"
                    Visibility="{Binding CancelButtonVisibility}">
                    <Image.ToolTip>
                        <TextBlock>Disconnected from game</TextBlock>
                    </Image.ToolTip>
                </Image>

                <materialDesign:PackIcon
                    VerticalAlignment="Center"
                    Foreground="Orange"
                    Kind="alertoctagram"
                    ToolTipService.InitialShowDelay="0"
                    Visibility="{Binding MessageAboutEditModeDisabledVisibility}">
                    <materialDesign:PackIcon.ToolTip>
                        <TextBlock>Edit mode disabled - enable in settings.</TextBlock>
                    </materialDesign:PackIcon.ToolTip>
                </materialDesign:PackIcon>

                <Button
                    Height="20"
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    Click="GlueViewSettingsButtonClicked"
                    Content="{materialDesign:PackIcon Cog}"
                    Style="{DynamicResource IconButton}" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ToolbarAndGame" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Stretch so we can drag drop  -->
            <StackPanel
                x:Name="ToolsSidePanel"
                Grid.RowSpan="2"
                Width="24"
                Margin="2,2,2,0"
                VerticalAlignment="Stretch"
                AllowDrop="True"
                Background="Transparent"
                DragEnter="ToolsSidePanel_DragEnter"
                Drop="ToolsSidePanel_Drop">
                <!--  This is here to control visibility of all controls but we want the left frame to always be around to prevent flickering  -->
                <StackPanel Opacity="{Binding ToolBarOpacity}">
                    <StackPanel Orientation="Vertical" Visibility="{Binding WhileRunningViewVisibility}">

                        <Button
                            Width="20"
                            HorizontalAlignment="Left"
                            Click="SelectStartupScreenButtonClicked"
                            Style="{DynamicResource IconButton}"
                            Visibility="{Binding FocusButtonVisibility}">
                            <Button.ToolTip>
                                <ToolTip>
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Text="{x:Static localization:Texts.SelectStartupScreen}" />
                                        <TextBlock Text="{x:Static localization:Texts.SelectStartupScreenInEdit}" />
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                            <Image IsHitTestVisible="False" Source="/GameCommunicationPlugin;component/GlueControl/Icons/SelectStartupScreen.png" />
                        </Button>

                        <Button
                            Width="20"
                            HorizontalAlignment="Left"
                            Click="FocusButtonClicked"
                            Style="{DynamicResource IconButton}"
                            Visibility="{Binding FocusButtonVisibility}">
                            <Button.ToolTip>
                                <ToolTip>
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Text="{x:Static localization:Texts.FocusOnSelection}" />
                                        <TextBlock Text="{x:Static localization:Texts.MoveCameraToItemPlayAnimation}" />
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                            <Image IsHitTestVisible="False" Source="/GameCommunicationPlugin;component/GlueControl/Icons/FocusOnSelection.png" />
                        </Button>

                    </StackPanel>

                    <views:EditingToolsView
                        x:Name="EditingTools"
                        Margin="0,1,0,0"
                        HorizontalAlignment="Left" />

                </StackPanel>
            </StackPanel>


            <Grid
                x:Name="BackgroundGrid"
                Grid.Column="1"
                Background="#555555"
                SizeChanged="BackgroundGrid_SizeChanged">

                <StackPanel>
                    <TextBlock
                        Foreground="White"
                        Text="{Binding GameRunningNotInWindowDisplay, FallbackValue=GameRunningExternally}"
                        TextWrapping="Wrap" />
                </StackPanel>

            </Grid>



            <Grid
                x:Name="MainGrid"
                Grid.Column="1"
                Visibility="{Binding WhileRunningEmbeddedVisibility}"
                SizeChanged="MainGrid_SizeChanged">
                <WindowsFormsHost
                    x:Name="WinformsHost"
                    IsHitTestVisible="False"
                    SizeChanged="WinformsHost_SizeChanged" />



            </Grid>
            <controls:ActivitySpinner Grid.Column="1" Visibility="{Binding BuildingActivitySpinnerVisibility}" />
            <views:BottomStatusBar
                Grid.Row="1"
                Grid.Column="1"
                Visibility="{Binding WhileRunningViewVisibility}"
                ZoomMinusClick="BottomStatusBar_ZoomMinusClick"
                ZoomPlusClick="BottomStatusBar_ZoomPlusClick" />

        </Grid>
    </Grid>
</UserControl>
