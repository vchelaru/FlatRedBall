<UserControl
    x:Class="FlatRedBall.PlatformerPlugin.Views.SlopeDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Height="40"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Canvas
            x:Name="Diagram"
            Grid.Column="0"
            RenderTransformOrigin=".5,.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform />
                    <SkewTransform />
                    <RotateTransform Angle="{Binding Path=DiagramAngle}" />
                    <TranslateTransform />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Ellipse
                Grid.Column="0"
                Width="40"
                Height="40"
                Stroke="Black">
                <Ellipse.Fill>
                    <SolidColorBrush Color="LightBlue" />
                </Ellipse.Fill>
            </Ellipse>
            <Path Fill="Green" Stroke="Black">
                <Path.Data>
                    <PathGeometry>
                        <PathGeometry.Figures>
                            <PathFigureCollection>
                                <PathFigure StartPoint=".5,20">
                                    <PathFigure.Segments>
                                        <PathSegmentCollection>
                                            <ArcSegment
                                                IsLargeArc="True"
                                                Point="39.5,20"
                                                Size="19.5,19.5"
                                                SweepDirection="CounterClockwise" />
                                        </PathSegmentCollection>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathFigureCollection>
                        </PathGeometry.Figures>
                    </PathGeometry>
                </Path.Data>
            </Path>
            <Line
                Canvas.Left="0"
                Canvas.Top="20"
                Stroke="Black"
                X1="0"
                X2="40"
                Y1="0"
                Y2="0" />
            <Line
                Canvas.Left="9"
                Canvas.Top="13"
                Stroke="Black"
                X1="0"
                X2="22"
                Y1="0"
                Y2="0" />
            <Polygon
                Canvas.Left="28"
                Canvas.Top="10"
                Fill="Black"
                Points="0,0 4,3, 0,6"
                Stroke="Black" />
        </Canvas>

        <TextBox
            x:Name="DegreeTextBox"
            Grid.Column="1"
            Width="20"
            Height="18"
            LostFocus="TextBox_LostFocus_1"
            PreviewKeyDown="TextBox_PreviewKeyDown_1" />

        <TextBlock Grid.Column="2" VerticalAlignment="Center">°</TextBlock>
    </Grid>
</UserControl>
