<UserControl
    x:Class="FlatRedBall.PlatformerPlugin.Views.PlatformerValuesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:FlatRedBall.PlatformerPlugin.WpfBehaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FlatRedBall.PlatformerPlugin.Views"
    xmlns:localization="clr-namespace:Localization;assembly=Localization"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="250"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>


        <Rectangle
            Grid.Row="0"
            Grid.Column="1"
            Grid.ColumnSpan="6"
            VerticalAlignment="Stretch"
            Fill="{DynamicResource Frb.Brushes.Contrast01}" />
        <Rectangle
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Width="1"
            HorizontalAlignment="Left"
            Fill="Gray" />
        <Rectangle
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="1"
            HorizontalAlignment="Left"
            Fill="Gray" />
        <Rectangle
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="2"
            Width="1"
            HorizontalAlignment="Left"
            Fill="Gray" />
        <Rectangle
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="3"
            Width="1"
            HorizontalAlignment="Left"
            Fill="Gray" />
        <Rectangle
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="4"
            Width="1"
            HorizontalAlignment="Left"
            Fill="Gray" />
        <Rectangle
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="5"
            Width="1"
            HorizontalAlignment="Left"
            Fill="Gray" />
        <Rectangle
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="6"
            Width="1"
            HorizontalAlignment="Left"
            Fill="Gray" />
        <Rectangle
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="6"
            Width="1"
            HorizontalAlignment="Right"
            Fill="Gray" />


        <Rectangle
            Grid.Row="0"
            Grid.ColumnSpan="7"
            Height="1"
            VerticalAlignment="Top"
            Fill="Black" />
        <Rectangle
            Grid.Row="0"
            Grid.Column="1"
            Grid.ColumnSpan="5"
            Height="1"
            VerticalAlignment="Bottom"
            Fill="Gray" />
        <Rectangle
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="7"
            Height="1"
            VerticalAlignment="Bottom"
            Fill="Gray" />

        <!--  Name  -->
        <StackPanel Grid.Row="1" Margin="3">
            <TextBlock
                Margin="3"
                HorizontalAlignment="Center"
                Text="{x:Static localization:Texts.MovementType}" />
            <TextBox
                Width="90"
                VerticalAlignment="Top"
                b:InputBindingsManager.UpdatePropertySourceWhenEnterPressed="TextBox.Text"
                IsEnabled="{Binding IsNameEditable}"
                Text="{Binding Name}" />
            <GroupBox Header="{x:Static localization:Texts.Inheritance}" Visibility="{Binding InheritBoxVisibility}">
                <StackPanel>
                    <RadioButton VerticalContentAlignment="Center" IsChecked="{Binding InheritMovementValues}">
                        <RadioButton.ToolTip>
                            <Label Content="{x:Static localization:Texts.HintEntityInheritsFromBase}" />
                        </RadioButton.ToolTip>
                        <Label Content="{x:Static localization:Texts.InheritValues}" />
                    </RadioButton>
                    <RadioButton VerticalContentAlignment="Center" IsChecked="{Binding OverwriteMovementValues}">
                        <RadioButton.ToolTip>
                            <Label Content="{x:Static localization:Texts.HintOverwriteHidesBase}" />
                        </RadioButton.ToolTip>
                        <Label Content="{x:Static localization:Texts.OverwriteValues}" />
                    </RadioButton>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!--  Horizontal Movement  -->
        <TextBlock
            Grid.Column="1"
            Margin="3,3,8,3"
            HorizontalAlignment="Left"
            FontSize="16"
            Text="{x:Static localization:Texts.HorizontalMovement}" />
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Margin="12,3,8,3"
            IsEnabled="{Binding IsEditable}">

            <TextBlock Text="{x:Static localization:Texts.MaxSpeed}" />
            <TextBox
                Width="70"
                Margin="0,0,0,5"
                HorizontalAlignment="Left"
                b:InputBindingsManager.UpdatePropertySourceWhenEnterPressed="TextBox.Text"
                Text="{Binding MaxSpeedX}">
                <TextBox.ToolTip>
                    <Label Content="{x:Static localization:Texts.HintMaxSpeedPerPixel}" />
                </TextBox.ToolTip>
            </TextBox>

            <RadioButton IsChecked="{Binding IsImmediate}">
                <RadioButton.ToolTip>
                    <Label Content="{x:Static localization:Texts.HintSpeedToMaxStopsImmediate}" />
                </RadioButton.ToolTip>
                <Label Content="{x:Static localization:Texts.Immediate}" />
            </RadioButton>
            <RadioButton Margin="0,0,0,5" IsChecked="{Binding UsesAcceleration}">
                <RadioButton.ToolTip>
                    <Label Content="{x:Static localization:Texts.HintSpeedToMaxStopsGradually}" />
                </RadioButton.ToolTip>
                <Label Content="{x:Static localization:Texts.SpeedUpDown}" />
            </RadioButton>

            <StackPanel Visibility="{Binding AccelerationValuesVisibility}">
                <TextBlock Text="{x:Static localization:Texts.SpeedUpTime}" />
                <TextBox
                    Width="50"
                    HorizontalAlignment="Left"
                    b:InputBindingsManager.UpdatePropertySourceWhenEnterPressed="TextBox.Text"
                    Text="{Binding AccelerationTimeX}">
                    <TextBox.ToolTip>
                        <Label Content="{x:Static localization:Texts.HintSecondsToAccelerate}" />
                    </TextBox.ToolTip>
                </TextBox>
                <TextBlock Text="{x:Static localization:Texts.SlowDownTime}" />
                <TextBox
                    Width="50"
                    HorizontalAlignment="Left"
                    b:InputBindingsManager.UpdatePropertySourceWhenEnterPressed="TextBox.Text"
                    Text="{Binding DecelerationTimeX}">
                    <TextBox.ToolTip>
                        <Label Content="{x:Static localization:Texts.HintSlowdownToStop}" />
                    </TextBox.ToolTip>
                </TextBox>

                <CheckBox
                    Margin="0,10,0,0"
                    VerticalContentAlignment="Center"
                    IsChecked="{Binding IsCustomDecelerationChecked}">
                    <CheckBox.ToolTip>
                        <Label Content="{x:Static localization:Texts.HintCustomDecelerationAboveMaxSpeed}" />
                    </CheckBox.ToolTip>
                    <Label Content="{x:Static localization:Texts.CustomDecelerationAboveMaxSpeed}" />
                </CheckBox>
                <TextBox
                    Width="70"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding IsCustomDecelerationValueEnabled}"
                    Text="{Binding CustomDecelerationValue}">
                    <TextBox.ToolTip>
                        <Label Content="{x:Static localization:Texts.HintDecelerationAboveMaxSpeed}" />
                    </TextBox.ToolTip>
                </TextBox>
            </StackPanel>
        </StackPanel>

        <!--  Slope Movement  -->
        <TextBlock
            Grid.Column="2"
            Margin="3,3,8,3"
            HorizontalAlignment="Left"
            FontSize="16"
            Text="{x:Static localization:Texts.SlopeMovement}" />
        <StackPanel
            Grid.Row="1"
            Grid.Column="2"
            Margin="12,3,8,3"
            IsEnabled="{Binding IsEditable}">
            <RadioButton VerticalContentAlignment="Center" IsChecked="{Binding MoveSameSpeedOnSlopes}">
                <RadioButton.ToolTip>
                    <Label Content="{x:Static localization:Texts.HintHorizontalMovementSlopesNotImpacted}" />
                </RadioButton.ToolTip>
                <Label Content="{x:Static localization:Texts.MoveSameSpeed}" />
            </RadioButton>
            <RadioButton VerticalContentAlignment="Center" IsChecked="{Binding AdjustSpeedOnSlopes}">
                <RadioButton.ToolTip>
                    <Label Content="{x:Static localization:Texts.HintHorizontalMovementSlopedImpacted}" />
                </RadioButton.ToolTip>
                <Label Content="{x:Static localization:Texts.SlopesChangeSpeed}" />
            </RadioButton>
            <StackPanel Margin="10,0,0,0" Visibility="{Binding SlopeMovementSpeedUiVisibility}">

                <StackPanel Orientation="Horizontal">
                    <StackPanel
                        Width="255"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock Text="{x:Static localization:Texts.SlopeMoveUphill}" />
                    </StackPanel>
                    <local:SlopeDisplay Angle="{Binding UphillFullSpeedSlope}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <StackPanel
                        Width="255"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock Text="Character stops moving uphill on slope" />
                    </StackPanel>
                    <local:SlopeDisplay Angle="{Binding UphillStopSpeedSlope}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <StackPanel
                        Width="255"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock Text="Character moves downhill at full speed on slope" />
                    </StackPanel>
                    <local:SlopeDisplay Angle="{Binding DownhillFullSpeedSlope}" IsInverted="True" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <StackPanel
                        Width="255"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Character moves downhill" />
                        <TextBox
                            Width="24"
                            Height="18"
                            Text="{Binding Path=DownhillMaxSpeedBoostPercentage, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static localization:Texts.XFasterOnSlope}" />
                    </StackPanel>
                    <local:SlopeDisplay Angle="{Binding DownhillMaxSpeedSlope}" IsInverted="True" />
                </StackPanel>

            </StackPanel>
        </StackPanel>

        <!--  Jumping  -->
        <TextBlock
            Grid.Column="3"
            Margin="3"
            HorizontalAlignment="Left"
            FontSize="16"
            Text="{x:Static localization:Texts.Jumping}" />
        <StackPanel
            Grid.Row="1"
            Grid.Column="3"
            Margin="12,3,8,3"
            IsEnabled="{Binding IsEditable}">
            <TextBlock Text="{x:Static localization:Texts.JumpSpeed}" />
            <TextBox
                Width="70"
                Margin="1,0,-1,5"
                HorizontalAlignment="Left"
                b:InputBindingsManager.UpdatePropertySourceWhenEnterPressed="TextBox.Text"
                Text="{Binding JumpVelocity}">
                <TextBox.ToolTip>
                    <Label Content="{x:Static localization:Texts.HintYVelocityForJumping}" />
                </TextBox.ToolTip>
            </TextBox>

            <CheckBox Margin="0,5,0,0" IsChecked="{Binding JumpApplyByButtonHold}">
                <CheckBox.ToolTip>
                    <Label Content="{x:Static localization:Texts.HintHoldToJumpHigher}" />
                </CheckBox.ToolTip>
                <Label Content="{x:Static localization:Texts.HoldToJumpHigher}" />
            </CheckBox>
            <StackPanel Visibility="{Binding JumpHoldTimeVisibility}">
                <TextBlock>Max Jump Hold Time:</TextBlock>
                <TextBox
                    Width="50"
                    HorizontalAlignment="Left"
                    b:InputBindingsManager.UpdatePropertySourceWhenEnterPressed="TextBox.Text"
                    Text="{Binding JumpApplyLength}">
                    <TextBox.ToolTip>
                        <Label Content="{x:Static localization:Texts.HintTimeAmountJumpHigher}" />
                    </TextBox.ToolTip>
                </TextBox>
            </StackPanel>

            <CheckBox Margin="0,10,0,0" IsChecked="{Binding CanFallThroughCloudPlatforms}">
                <CheckBox.ToolTip>
                    <Label Content="{x:Static localization:Texts.HintPressDownThroughClouds}" />
                </CheckBox.ToolTip>
                <Label Content="Can Fall Through Clouds" />
            </CheckBox>
            <StackPanel Visibility="{Binding FallThroughCloudPlatformsVisibility}">
                <TextBlock>
                    <Label Content="Cloud Platform Thickness:" />
                </TextBlock>
                <TextBox
                    Width="50"
                    HorizontalAlignment="Left"
                    b:InputBindingsManager.UpdatePropertySourceWhenEnterPressed="TextBox.Text"
                    Text="{Binding CloudFallThroughDistance}">
                    <TextBox.ToolTip>
                        <Label Content="{x:Static localization:Texts.HintDistancePressCloudCollision}" />
                    </TextBox.ToolTip>
                </TextBox>
            </StackPanel>
        </StackPanel>

        <!--  Falling  -->
        <TextBlock
            Grid.Column="4"
            Margin="3"
            HorizontalAlignment="Left"
            FontSize="16"
            Text="{x:Static localization:Texts.Falling}" />
        <StackPanel
            Grid.Row="1"
            Grid.Column="4"
            Margin="12,3,8,3"
            IsEnabled="{Binding IsEditable}">
            <TextBlock Text="{x:Static localization:Texts.Gravity}" />
            <TextBox
                Width="70"
                HorizontalAlignment="Left"
                b:InputBindingsManager.UpdatePropertySourceWhenEnterPressed="TextBox.Text"
                Text="{Binding Gravity}">
                <TextBox.ToolTip>
                    <Label Content="{x:Static localization:Texts.HintGravityApply}" />
                </TextBox.ToolTip>
            </TextBox>
            <TextBlock
                MaxWidth="150"
                Margin="0,0,0,5"
                HorizontalAlignment="Left"
                FontSize="9"
                Foreground="Red"
                Text="{x:Static localization:Texts.HintIfValuesUsedForGroundMovement}"
                TextWrapping="Wrap"
                Visibility="{Binding Gravity0WarningVisibility}" />
            <TextBlock Text="{x:Static localization:Texts.MaxFallingSpeed}" />
            <TextBox
                Width="50"
                HorizontalAlignment="Left"
                b:InputBindingsManager.UpdatePropertySourceWhenEnterPressed="TextBox.Text"
                Text="{Binding MaxFallSpeed}">
                <TextBox.ToolTip>
                    <Label Content="{x:Static localization:Texts.MaxSpeed}" />
                </TextBox.ToolTip>
            </TextBox>
            <TextBlock
                MaxWidth="150"
                Margin="0,0,0,5"
                HorizontalAlignment="Left"
                FontSize="9"
                Foreground="Red"
                TextWrapping="Wrap"
                Visibility="{Binding MaxFallingSpeed0WarningVisibility}">
                <Label Content="{x:Static localization:Texts.HintValuesGroundMovementFallingSpeed}" />
            </TextBlock>

        </StackPanel>

        <TextBlock
            Grid.Column="5"
            Margin="3"
            HorizontalAlignment="Left"
            FontSize="16"
            Text="Climbing" />
        <StackPanel
            Grid.Row="1"
            Grid.Column="5"
            Margin="12,3,8,3"
            IsEnabled="{Binding IsEditable}">
            <CheckBox
                Margin="0,10,0,0"
                VerticalContentAlignment="Center"
                IsChecked="{Binding CanClimb}">
                <CheckBox.ToolTip>
                    <Label Content="{x:Static localization:Texts.HintClimbingPressingUp}" />
                </CheckBox.ToolTip>
                <Label Content="Can Climb" />
            </CheckBox>
            <TextBlock
                Margin="0,5,0,0"
                Text="Climbing Speed:"
                Visibility="{Binding ClimbingUiVisibility}" />
            <TextBox
                Width="70"
                HorizontalAlignment="Left"
                b:InputBindingsManager.UpdatePropertySourceWhenEnterPressed="TextBox.Text"
                Text="{Binding MaxClimbingSpeed}"
                Visibility="{Binding ClimbingUiVisibility}">
                <TextBox.ToolTip>
                    <Label Content="{x:Static localization:Texts.HintVerticalSpeedForClimbing}" />
                </TextBox.ToolTip>
            </TextBox>

        </StackPanel>

        <Button
            Grid.Column="6"
            Click="HandleXClick"
            Content="{materialDesign:PackIcon CloseCircle}"
            Style="{DynamicResource ToolIcon}"
            Visibility="{Binding DeleteButtonVisibility}">
            <Button.ToolTip>
                <Label Content="{x:Static localization:Texts.HintDeletesMovementValues}" />
            </Button.ToolTip>
        </Button>

        <StackPanel Grid.Row="1" Grid.Column="6">
            <Button
                x:Name="MoveUpButton"
                Margin="-2"
                Click="HandleMoveUpClicked"
                Content="{materialDesign:PackIcon Kind=MenuUp}"
                Style="{DynamicResource IconButton}" />
            <Button
                x:Name="MoveDownButton"
                Margin="-2"
                Click="HandleMoveDownClicked"
                Content="{materialDesign:PackIcon Kind=MenuDown}"
                Style="{DynamicResource IconButton}" />
            <Button
                x:Name="DuplicateButton"
                Width="16"
                Margin="0,5,0,0"
                Click="HandleDuplicateClicked"
                Content="{materialDesign:PackIcon Kind=ContentDuplicate}"
                Style="{DynamicResource ToolIcon}">
                <Button.ToolTip>
                    <Label Content="{x:Static localization:Texts.HintDuplicateMovementValues}" />
                </Button.ToolTip>
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
