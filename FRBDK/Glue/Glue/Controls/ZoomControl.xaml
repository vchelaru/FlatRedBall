<UserControl
    x:Class="FlatRedBall.Glue.Controls.ZoomControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FlatRedBall.Glue.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Height="28"
    d:DesignWidth="200"
    mc:Ignorable="d">
    <Grid Margin="0,0,0,0" HorizontalAlignment="Left">
        <StackPanel
            Margin="0,0,3,0"
            VerticalAlignment="Stretch"
            Orientation="Horizontal">
            <Button
                Height="16"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="ZoomMinusClicked"
                Content="{materialDesign:PackIcon Minus}"
                Style="{DynamicResource IconButton}"
                Visibility="{Binding ButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Button.ToolTip>
                    <ToolTip>
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Text="Zoom In" />
                        </StackPanel>
                    </ToolTip>
                </Button.ToolTip>
            </Button>
            <materialDesign:PackIcon
                Margin="2,0,0,0"
                VerticalAlignment="Center"
                Kind="Search" />
            <TextBlock
                Margin="0,0,2,0"
                VerticalAlignment="Center"
                Text="{Binding CurrentZoomLevelDisplay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Button
                Height="16"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="ZoomPlusClicked"
                Content="{materialDesign:PackIcon Plus}"
                Style="{DynamicResource IconButton}"
                Visibility="{Binding ButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Button.ToolTip>
                    <ToolTip>
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Text="Zoom Out" />
                        </StackPanel>
                    </ToolTip>
                </Button.ToolTip>
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
