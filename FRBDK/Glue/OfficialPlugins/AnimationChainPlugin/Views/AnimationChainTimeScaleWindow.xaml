<Window x:Class="OfficialPlugins.AnimationChainPlugin.Views.AnimationChainTimeScaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OfficialPlugins.AnimationChainPlugin.Views"
        mc:Ignorable="d"
        SizeToContent="Height" Width="400">
  <StackPanel Margin="8">
    <Label Content="Set the desired animation length (in seconds):"/>
    <TextBox Text="{Binding LengthInSeconds, UpdateSourceTrigger=PropertyChanged}"/>
    <GroupBox Header="Frame time options" Margin="0,10,0,0">
      <StackPanel>
        <RadioButton Content="Keep frame times proportional"
                     IsChecked="{Binding IsProportionalChecked}"/>
        <RadioButton Content="{Binding EachFrameDisplay, FallbackValue=SetToX}"
                     IsChecked="{Binding IsUniformChecked}"/>
      </StackPanel>
    </GroupBox>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="OK" Margin="5" Width="60" Click="HandleOkClick"/>
      <Button Content="Cancel" Margin="5" Width="60" Click="HandleCancelClick" />
    </StackPanel>
  </StackPanel>
</Window>
