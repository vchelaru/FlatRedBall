<UserControl
    x:Class="OfficialPlugins.ContentPreview.Views.AchxPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:GlueControls="clr-namespace:FlatRedBall.Glue.Controls;assembly=GlueFormsCore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pt="http://propertytools.org/wpf"
    xmlns:themes="clr-namespace:FlatRedBall.Glue.Themes;assembly=GlueFormsCore"
    xmlns:wpf1="clr-namespace:SkiaGum.Wpf;assembly=SkiaGum.Wpf"
    xmlns:wpfdataui="clr-namespace:WpfDataUi;assembly=WpfDataUi"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Menu>
                <MenuItem Header="...">
                    <MenuItem Click="OpenInAnimationEditorButton_Click" Header="Open in External AnimationEditor" />
                    <MenuItem Click="ExportClicked" Header="Export" />
                </MenuItem>

            </Menu>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!--  Tab control for animation and settings...  -->
            <TabControl themes:FrbTabControl.PreferTabTruncation="True">
                <TabItem themes:FrbTabControl.TruncationIcon="RunFast" Header="Animations">
                    <Grid x:Name="ListViewGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="5" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <!--  Main ListBox - eventually will get broken up into 2 list boxes  -->

                        <pt:TreeListBox
                            x:Name="ListBox"
                            ChildrenPath="VisibleChildren"
                            DisplayMemberPath="Text"
                            HierarchySource="{Binding VisibleRoot}"
                            MouseDoubleClick="TreeListBox_MouseDoubleClick"
                            PreviewKeyDown="TreeListBox_PreviewKeyDown"
                            SelectedItem="{Binding SelectedItem}">

                            <pt:TreeListBox.ContextMenu>
                                <ContextMenu x:Name="AnimationListBoxContextMenu" />
                            </pt:TreeListBox.ContextMenu>
                        </pt:TreeListBox>
                        <GridSplitter
                            Grid.Row="1"
                            Height="5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center" />
                        <ScrollViewer Grid.Row="2">
                            <wpfdataui:DataUiGrid x:Name="PropertyGrid" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem themes:FrbTabControl.TruncationIcon="Gear" Header="Settings">
                    <wpfdataui:DataUiGrid x:Name="SettingsPropertyGrid" />

                </TabItem>
            </TabControl>

            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch" />

            <!--  Grid displaying the top and bottom Skia windows  -->
            <Grid x:Name="PreviewGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="223*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="65*" />
                    <RowDefinition Height="157*" />
                </Grid.RowDefinitions>

                <!--  Top Window Settings (snapping)  -->
                <StackPanel Orientation="Horizontal">
                    <GlueControls:ZoomControl
                        CurrentZoomLevelDisplay="{Binding TopWindowZoom.CurrentZoomDisplay}"
                        ZoomMinusClick="HandleTopWindowZoomOut"
                        ZoomPlusClick="HandleTopWindowZoomIn" />


                    <CheckBox
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Content="Snap to grid"
                        IsChecked="{Binding IsSnappingChecked}" />
                    <TextBox
                        Width="44"
                        Margin="10,0,0,0"
                        IsEnabled="{Binding IsSnappingChecked}"
                        Text="{Binding SnappingSize}" />
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="134*" />
                        <RowDefinition Height="71*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>


                    <wpf1:GumSKElement
                        x:Name="TopGumCanvas"
                        Grid.RowSpan="3"
                        Margin="0,0,0,8"
                        MouseDown="TopGumCanvas_MouseDown"
                        MouseMove="TopGumCanvas_MouseMove"
                        MouseUp="TopGumCanvas_MouseUp"
                        MouseWheel="TopGumCanvas_MouseWheel"
                        SizeChanged="TopGumCanvas_SizeChanged" />
                    <ScrollBar
                        x:Name="TopWindowVerticalSrollBar"
                        Grid.RowSpan="3"
                        Grid.Column="1"
                        ValueChanged="TopWindowVerticalSrollBar_ValueChanged" />
                    <ScrollBar
                        x:Name="TopWindowHorizontalScrollBar"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        ValueChanged="TopWindowHorizontalScrollBar_ValueChanged" />

                </Grid>
                <GridSplitter
                    Grid.Row="2"
                    Height="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    ResizeBehavior="PreviousAndNext"
                    ShowsPreview="True" />
                <Grid
                    x:Name="BottomHalfGrid"
                    Grid.Row="3"
                    Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <wpf1:GumSKElement
                        x:Name="BottomGumCanvas"
                        Grid.Row="0"
                        MouseDown="BottomCanvas_MouseDown"
                        MouseMove="BottomCanvas_MouseMove"
                        MouseWheel="BottomCanvas_MouseWheel" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Label Content="{Binding ResolutionDisplay, FallbackValue=300x500}" />
                    </StackPanel>
                </Grid>
            </Grid>


        </Grid>
    </Grid>

</UserControl>
