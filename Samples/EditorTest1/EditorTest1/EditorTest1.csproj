  <ItemGroup>
    <!-- The whole engine comes from NuGet, so it moves as one matched set on restore. These five
         used to be split: the engine from NuGet and the rest as loose DLLs in a Libraries folder,
         which let a project pair a current engine with a months-old GumCore. -->
    <PackageReference Include="FlatRedBallDesktopGLNet6" Version="2026.8.5.886" />
    <PackageReference Include="FlatRedBall.Forms.DesktopGlNet6" Version="2026.8.5.886" />
    <PackageReference Include="FlatRedBall.GumCore.DesktopGlNet6" Version="2026.8.5.886" />
    <PackageReference Include="FlatRedBall.SkiaInGum" Version="2026.8.5.886" />
    <PackageReference Include="FlatRedBall.StateInterpolation.DesktopNet6" Version="2026.8.5.886" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5-develop.11" />
    <PackageReference Include="Newtonsoft.Json">
      <Version>13.0.3</Version>
    </PackageReference>
    <!-- Must stay at or above what FlatRedBall.SkiaInGum was built against, or restore reports a
         downgrade. -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Content\Shader.fx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\shader.xnb">
