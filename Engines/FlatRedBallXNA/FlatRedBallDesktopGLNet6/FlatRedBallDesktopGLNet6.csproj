<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net8.0</TargetFrameworks>

    
		<DefineConstants>TRACE;MONOGAME; DESKTOP_GL; MONOGAME_381</DefineConstants>
		<Title>FlatRedBall (.NET Desktop GL)</Title>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>FlatRedBall Game Engine</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Version>1.0.0</Version>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>

  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <NoWarn>1701;1702; 1591</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <NoWarn>1701;1702; 1591</NoWarn>
	</PropertyGroup>
	<Import Project="..\FlatRedBall\FlatRedBallShared.projitems" Label="Shared" />

	<ItemGroup>
		<PackageReference Include="AsepriteDotNet" Version="1.9.1" />
    <!-- net8 gets MonoGame 3.8.4.1 (OpenAL 1.24.3 -> device-follow shim / issue #9467).
         net6 stays on 3.8.1.303: MonoGame 3.8.4.1 ships net8.0 only. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" Condition="'$(TargetFramework)' == 'net8.0'">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" Condition="'$(TargetFramework)' != 'net8.0'">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
	</ItemGroup>
</Project>
